# Dependencies
node_modules/
.pnpm-store/

# Build outputs
**/dist/
**/.wrangler/

# Secrets — never commit. `.dev.vars.example` and `.env.test` (dummy values) ARE committed.
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
.env
.env.local
*.local
.secrets.*.json
# the analytics plugin's local tooling config (D31) — never committed
.drizzle-cube.json
.cfld.json

# Logs / coverage
logs/
*.log
coverage/
*.lcov

# Editor / OS
.DS_Store
.idea/
.vscode/

# Drizzle studio
.drizzle/

# Agent worktrees (transient, each is its own git repo)
.claude/worktrees/
.claude/settings.local.json

# `pnpm dev` writes this when the remote sandbox host is reachable (wrangler.toml + a dev-only binding)
apps/web/wrangler.dev-remote.toml

# A deployed instance (`pnpm provision`, docs/DEPLOYMENT.md): its answers and secrets
# (`launch.deploy.env`, a second instance's `launch.<x>.deploy.env`; the `.example` IS committed),
# the ids provisioning created and the GitHub App key (`.launch/`), and the wrangler config rendered
# from wrangler.toml for it. None of it belongs in git; back the first two up.
launch.deploy.env
launch.*.deploy.env
.launch/
apps/web/wrangler.deploy.toml
# The pre-instance locations (no longer read; `pnpm provision check` says to move the file).
apps/web/.provision.json
apps/web/.provision.env

# Plugins installed into THIS checkout only (D31): `pnpm plugin add --local`.
# Installed plugins are recorded in the committed `launch.plugins.json` instead.
launch.plugins.local.json

# Plugin cache — a bare mirror of every plugin repository `pnpm plugin add|upgrade` has fetched,
# plus upgrade work artifacts (scripts/lib/git-lib.mjs). Safe to delete at any time.
.plugin-cache/

# Launch
spikes/.env
spikes/.created.json
*.pem
.state.json
spikes/.ssh/
