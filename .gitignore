# Dependencies
node_modules/
.pnpm-store/

# Build outputs
**/dist/
**/.wrangler/

# Secrets — never commit. `.dev.vars.example` and `.env.test` (dummy values) ARE committed.
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
.env
.env.local
*.local
.secrets.*.json
# the analytics plugin's local tooling config (D31) — never committed
.drizzle-cube.json
.cfld.json

# Logs / coverage
logs/
*.log
coverage/
*.lcov

# Editor / OS
.DS_Store
.idea/
.vscode/

# Drizzle studio
.drizzle/

# Agent worktrees (transient, each is its own git repo)
.claude/worktrees/
.claude/settings.local.json

# `pnpm dev` with SESSION_SANDBOX_HOST=remote writes this (wrangler.toml + a dev-only binding)
apps/web/wrangler.dev-remote.toml

# Provisioning answer cache (ids and hostnames only — no secrets; scripts/provision.ts)
apps/web/.provision.json
# Provisioning tokens — the four vendor tokens (+ optional Worker secrets) read by scripts/provision.ts;
# written 0600 by `pnpm provision tokens`. `.provision.env.example` (blank values) IS committed.
apps/web/.provision.env

# Plugins installed into THIS checkout only (D31): `pnpm plugin add --local`.
# Installed plugins are recorded in the committed `launch.plugins.json` instead.
launch.plugins.local.json

# Plugin cache — a bare mirror of every plugin repository `pnpm plugin add|upgrade` has fetched,
# plus upgrade work artifacts (scripts/lib/git-lib.mjs). Safe to delete at any time.
.plugin-cache/

# Launch
spikes/.env
spikes/.created.json
*.pem
.state.json
spikes/.ssh/
