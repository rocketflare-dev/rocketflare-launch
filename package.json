{
  "name": "launch",
  "version": "0.15.0",
  "private": true,
  "license": "MIT",
  "description": "Launch \u2014 multi-tenant SaaS starter kit \u2014 pnpm workspace: apps/web (Hono API + React UI on Cloudflare Workers), apps/cli, packages/shared",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --silent --filter @launch/web dev",
    "dev:stop": "pnpm --filter @launch/web dev:stop",
    "dev:status": "pnpm --filter @launch/web dev:status",
    "dev:tunnel": "pnpm --filter @launch/web dev:tunnel",
    "dev:db:up": "pnpm --filter @launch/web dev:db:up",
    "dev:db:down": "pnpm --filter @launch/web dev:db:down",
    "dev:db:status": "pnpm --filter @launch/web dev:db:status",
    "bootstrap": "node scripts/bootstrap.mjs",
    "plugin": "node scripts/plugin.mjs",
    "preflight": "node scripts/bootstrap.mjs --check",
    "test:db:up": "pnpm --filter @launch/web test:db:up",
    "test:neon": "pnpm --filter @launch/web test:neon",
    "test:db:down": "pnpm --filter @launch/web test:db:down",
    "db:generate": "pnpm --filter @launch/web db:generate",
    "db:migrate": "pnpm --filter @launch/web db:migrate",
    "db:migrate:ci": "pnpm --filter @launch/web db:migrate:ci",
    "db:studio": "pnpm --filter @launch/web db:studio",
    "seed": "pnpm --filter @launch/web seed",
    "types": "pnpm --filter @launch/web types",
    "lint": "biome check . --diagnostic-level=error",
    "lint:all": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format . --write",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "eval": "pnpm --silent --filter @launch/evals eval",
    "eval:baseline": "pnpm --silent --filter @launch/evals eval:baseline",
    "eval:view": "pnpm --silent --filter @launch/evals eval:view",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "clean:deep": "pnpm clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "web": "pnpm --filter @launch/web",
    "cli": "pnpm --filter @launch/cli exec tsx src/cli.ts",
    "deploy": "pnpm --filter @launch/web deploy",
    "deploy:staging": "pnpm --filter @launch/web deploy:staging",
    "provision": "pnpm --filter @launch/web provision"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
