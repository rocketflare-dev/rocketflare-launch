# Copy to spikes/.env and fill in. Every resource the spikes create is named rfspike-*
# and recorded in spikes/.created.json; `node spikes/teardown.mjs` removes them.

# --- Cloudflare (S0, S1, S2, S3, S6, S7) ---
CF_ACCOUNT_ID=
# The dedicated apps domain (spec/04), e.g. company-apps.com. Spikes create rfspike-* hosts and
# routes on it, plus a notifications.<zone> Resend domain unless one is already verified.
CF_ZONE_ID=
CF_ZONE_NAME=
# An account-owned token created in the dashboard. It needs:
#   Account: Workers Scripts Edit, Workers KV Storage Edit, Hyperdrive Edit, Containers Edit,
#            Queues Read, Workers R2 Storage Read, Account API Tokens Edit, Account Settings Read
#   Zone (the zone above): Zone Read, DNS Edit, Workers Routes Edit, SSL and Certificates Read
CF_ADMIN_TOKEN=

# --- GitHub (S5) --- the org is NOT on Enterprise
# App repository permissions (read & write): Administration, Contents, Workflows, Actions,
# Environments, Secrets, Deployments, Pull requests. Installed on "All repositories".
GH_ORG=
GH_APP_ID=
# Path to the App's private key (.pem). Keep it outside the repo, or it is gitignored here.
GH_APP_PRIVATE_KEY_PATH=
GH_APP_INSTALLATION_ID=
# Optional: a PAT of an org/repo admin, used only to show what the fallback cannot stop.
GH_TEST_ADMIN_TOKEN=

# --- Neon (S0, S3) ---
NEON_API_KEY=
NEON_ORG_ID=

# --- Resend (S0, S4) --- a full-access key
RESEND_API_KEY=
# Where test emails go.
RESEND_TEST_TO=

# --- Anthropic (S7) ---
ANTHROPIC_API_KEY=
