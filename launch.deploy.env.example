# ONE Launch instance, in one file. Copy it, keep it private, fill it in:
#
#   cp launch.deploy.env.example launch.deploy.env && chmod 600 launch.deploy.env
#
# `pnpm provision all` reads it (docs/DEPLOYMENT.md, the /launch-deploy skill). It is git-ignored;
# the scripts never print a value from it, and `pnpm provision check` reports NAMES only. An
# exported variable of the same name wins over a line here (CI). A second instance (staging, say)
# is a second file: `LAUNCH_DEPLOY_FILE=launch.staging.deploy.env pnpm provision all`.
#
# BACK THIS FILE UP (with the .launch/ directory beside it) somewhere safe — a password manager
# or encrypted storage. Once `secrets` has run it holds OAUTH_ENCRYPTION_KEY, the key that unseals
# every credential Launch stores; losing it means re-entering all of them.
# Never paste another environment's credentials into a comment: a comment is still on disk.

# ---- 1. The instance ---------------------------------------------------------------------------
# The Cloudflare zone your apps live under (must be a zone in the token's account). Required.
LAUNCH_DOMAIN=
# Where Launch itself is served — a Worker custom domain. Default: launch.<LAUNCH_DOMAIN>
LAUNCH_HOST=
# The Worker name and the prefix of every account-scoped resource (<name>-jobs, <name>-files,
# <name>-agent-run, <NAME>_RATE_LIMIT). Default: launch. Change it only to run two instances in
# one Cloudflare account.
LAUNCH_NAME=
# Who owns the instance: comma-separated; the first becomes the organisation's owner. Required.
LAUNCH_ADMIN_EMAILS=
# The GitHub organization Launch creates apps in (you must be an owner to create its App). Required.
LAUNCH_GITHUB_ORG=
# The instance's own Neon project, and the region every app's database is pinned to.
# Default: aws-eu-central-1 (https://neon.com/docs/introduction/regions)
NEON_REGION=
# Only for a PERSONAL Neon key that belongs to several organizations: the org to use (org-…).
NEON_ORG_ID=
# The Resend sending domain. Default: notifications.<LAUNCH_DOMAIN>
EMAIL_DOMAIN=
# The Resend region: us-east-1 (default) | eu-west-1 | sa-east-1 | ap-northeast-1
EMAIL_REGION=

# ---- 2. Account tokens (provisioning uses them, then `setup` seals them into the instance) -----
# An ACCOUNT-owned token: Cloudflare dashboard → Manage Account → Account API Tokens → Create.
# `pnpm provision check` prints a link that pre-fills it (docs/DEPLOYMENT.md has it too). Needs:
# Account — Workers Scripts, Workers KV Storage, Queues, Workers R2 Storage, Containers: Edit;
# Workers AI, Account Settings: Read. Zone — Zone: Read; DNS, Workers Routes: Edit.
CLOUDFLARE_API_TOKEN=
# Optional: discovered when the token sees exactly one account (32 hex, in the dashboard URL).
CLOUDFLARE_ACCOUNT_ID=
# https://console.neon.tech → your organization → Settings → API keys: an ORGANIZATION key.
NEON_API_KEY=
# https://resend.com/api-keys — FULL access (Launch mints a sending key per app with it; the
# Worker's own sending key is minted by `pnpm provision email verify` and never written here).
RESEND_API_KEY=

# ---- 3. GitHub App — written by `pnpm provision github-app` (you click Create, then Install) ----
GITHUB_APP_ID=
# Path of the app's private key, relative to the repo root (default .launch/github-app.pem, 0600).
GITHUB_APP_PRIVATE_KEY_FILE=
# Optional: the name the app is created with. Default: "Launch <org>" (GitHub names are global).
GITHUB_APP_NAME=
# The app's webhook secret (issue #19) — written here from GitHub's answer when the phase creates
# the app; for an app made before, paste the secret you set on it (docs/DEPLOYMENT.md § GitHub App
# webhooks). `pnpm provision secrets` puts it on the Worker. Blank = no webhooks; Launch polls.
GITHUB_WEBHOOK_SECRET=

# ---- 4. Optional Worker secrets — `pnpm provision secrets` puts each one that is set ------------
# Coding sessions and AI (Setup also stores the first two as sealed credentials)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDINGS_API_KEY=
# Sign in with Google / Microsoft / any OIDC issuer (SETUP.md; redirect URIs are on the login docs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OIDC_CLIENT_SECRET=
# AI tracing (D32): Langfuse keys, or OTLP headers for another backend (k=v,k=v)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_HEADERS=
# Coding sessions' workspace backups over presigned R2 URLs (docs/DEPLOY.md § Coding sessions)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- 5. Generated — do not edit ----------------------------------------------------------------
# Written by `pnpm provision secrets` on its first run, BEFORE it is put on the Worker. It seals
# every Setup credential and OAuth token. Back this file up; `--rotate` replaces it.
OAUTH_ENCRYPTION_KEY=
